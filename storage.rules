rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 정적 공개 자산 (업로드는 콘솔/CLI 전용)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // 게시글 이미지 공개 읽기
    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 나머지는 인증 필요
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
